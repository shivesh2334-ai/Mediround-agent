ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Shared secret the UI sends as x-agent-key (protects PHI + API spend)
AGENT_API_KEY=change-me
MEDIROUND_BASE=https://www.mediround.in
# Optional: remote browser (Browserless/Browserbase). Recommended on Vercel Hobby (60s limit).
BROWSER_WS_ENDPOINT=
# Optional local dev: path to Chrome/Chromium
CHROME_EXECUTABLE_PATH=
# Optional: Playwright storageState JSON if Mediround needs a login
MEDIROUND_STORAGE_STATE=
